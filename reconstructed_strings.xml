# Helper function to parse XML file using regex
function Parse-StringsFile($filePath) {
if (Test-Path $filePath) {
$content = Get-Content $filePath -Raw
# Match <string name="name">value</string>
$matches = [regex]::Matches($content, '<string\s+name="([^"]+)"[^>]*?>(.*?)</string>', [System.Text.RegularExpressions.RegexOptions]::Singleline)
foreach ($m in $matches) {
$name = $m.Groups[1].Value
$val = $m.Groups[2].Value
# Clean up JSON backslash escapes: replace \\\\ with \\ and \\ with \
$val = $val.Replace('\\\\', '\').Replace('\\', '\')
$allStrings[$name] = $val
}
foreach ($m in $pluralsMatches) {
$name = $m.Groups[1].Value
$val = $m.Groups[2].Value
$allStrings["PLURAL_$name"] = $val
}
}
}
