<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reminderBody"
    style="@style/AddFormRow">

    <TextView
        style="@style/TitleLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/reminder_label" />

    <ImageView
        android:id="@+id/ivBatteryWarning"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/battery_optimization_content_description"
        android:src="@drawable/ic_warning"
        android:visibility="gone"
        app:tint="@color/add_form_text_secondary" />

    <TextView
        android:id="@+id/txtReminderTime"
        style="@style/ValueText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="12dp"
        android:text="@string/time_placeholder"
        android:textColor="@color/brand_blue"
        android:visibility="gone" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchReminder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
