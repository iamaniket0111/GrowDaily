<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/task_fragment_card"
    android:padding="20dp">

    <!-- Section Title -->
    <TextView
        android:id="@+id/txtTotalTitle"
        style="@style/AnalysisTitle"
        android:text="COMPLETION RATE"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Left Side: Detailed Counts -->
    <LinearLayout
        android:id="@+id/layoutLeftStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintBottom_toBottomOf="parent"
         >

        <TextView
            android:id="@+id/txtTotalAchieved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_blue"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="313 Completed" />

        <TextView
            android:id="@+id/txtTotalMissed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/task_text_secondary"
            android:textSize="14sp"
            android:textStyle="normal"
            tools:text="62 Incomplete" />

    </LinearLayout>

    <!-- Right Side: Progress Semi-Circle Hub -->
    <FrameLayout
        android:id="@+id/layoutSemiCircle"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.anitech.growdaily.view.SemiCircleProgressView
            android:id="@+id/progressOverall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Percentage and Ratio Text -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtMainPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/brand_blue"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    tools:text="85" />

                <TextView
                    android:id="@+id/txtMainPercentageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:alpha="0.8"
                    android:text="%"
                    android:textColor="@color/brand_blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtCompletionRatio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:alpha="0.6"
                android:textColor="@color/task_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="313/375" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
