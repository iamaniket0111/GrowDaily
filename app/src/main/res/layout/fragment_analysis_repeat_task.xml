<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/task_screen_bg"
    tools:context=".fragment.AnalysisRepeatTaskFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <include
                android:id="@+id/header"
                style="@style/AnalysisCardInclude"
                layout="@layout/layout_combined_icon_header" />

            <include
                android:id="@+id/overview"
                style="@style/AnalysisCardInclude"
                layout="@layout/layout_analysis_overview" />

            <include
                android:id="@+id/totalCompletion"
                style="@style/AnalysisCardInclude"
                layout="@layout/layout_total_completion" />

            <include
                android:id="@+id/yearHeapMap"
                style="@style/AnalysisCardInclude"
                layout="@layout/layout_heatmap_analysis" />

            <include
                android:id="@+id/weekExpanded"
                style="@style/AnalysisCardInclude"
                layout="@layout/layout_week_analysis_expanded" />

            <include
                android:id="@+id/progressBar"
                style="@style/AnalysisCardInclude"
                layout="@layout/layout_analysis_progress"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
