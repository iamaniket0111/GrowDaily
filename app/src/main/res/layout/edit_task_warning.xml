<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AddTaskInfoCard"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/ivWarningIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/circle_background"
        android:backgroundTint="@color/task_filter_selected_bg"
        android:padding="6dp"
        android:src="@drawable/ic_info"
        app:tint="@color/brand_blue" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvInfoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Changes apply from today"
            android:textColor="@color/add_form_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="1dp"
            android:text="Today's progress may update. Past progress won't be affected."
            android:textColor="@color/add_form_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>