<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/tvVersioningHint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/add_task_info_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp"
    android:visibility="visible"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/ivWarningIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/circle_background"
        android:backgroundTint="@color/task_filter_selected_bg"
        android:padding="6dp"
        android:src="@drawable/ic_warning"
        app:tint="@color/brand_blue" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWarningTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Changes apply going forward"
            android:textColor="@color/add_form_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWarningDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="1dp"
            android:text="Priority, tracking, and repeat changes apply from today onward only. Past progress stays unchanged."
            android:textColor="@color/add_form_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>