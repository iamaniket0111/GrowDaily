<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/body"
        style="@style/TaskItemBodyCard"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                style="@style/TaskItemIconFrame"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/imageProfile"
                    style="@style/TaskItemIcon" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/taskType"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="12sp"
                        style="@style/TaskItemMetaText"
                        tools:text="Daily" />



                    <LinearLayout
                        android:id="@+id/weightContainer"
                        style="@style/TaskItemBadgeContainer"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1dp">

                        <TextView
                            android:id="@+id/taskWeight"
                            style="@style/TaskItemBadgeText"
                            android:textColor="@color/task_text_secondary"
                            android:textSize="11sp"
                            tools:text="1/4" />

                        <ImageView
                            android:id="@+id/flag"
                            style="@style/TaskItemBadgeIcon"
                            android:src="@drawable/ic_flag_fill"
                            app:tint="#C2C8E2" />
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/streakContainer"
                        style="@style/TaskItemBadgeContainer"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1dp">

                        <TextView
                            android:id="@+id/txtStreakCount"
                            style="@style/TaskItemBadgeText"
                            android:textColor="@color/task_text_secondary"
                            android:textSize="11sp"
                            tools:text="0" />

                        <ImageView
                            android:id="@+id/fire"
                            style="@style/TaskItemBadgeIcon"
                            android:src="@drawable/ic_fire_fill"
                            app:tint="#C2C8E2" />
                    </LinearLayout>


                </LinearLayout>

                <TextView
                    android:id="@+id/taskTitle"
                    style="@style/TaskItemTitleText"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:minLines="1"
                    android:textSize="13sp" />

            </LinearLayout>


            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressBar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:trackThickness="4dp"
                    android:layout_gravity="center"
                    />

                <!-- Center text -->
                <TextView
                    android:id="@+id/txtScoreOutOf10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="0.0"
                    android:textColor="@color/brand_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </FrameLayout>


        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/heatmapScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:overScrollMode="never"
            android:scrollbars="none">

        <com.anitech.growdaily.view.HeatmapLayout
                android:id="@+id/heatmapView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/weekRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:nestedScrollingEnabled="false" />


    </LinearLayout>
</LinearLayout>
