<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/priorityContainer"
    style="@style/AddFormCard"
    android:layout_height="56dp"
    android:padding="12dp">

    <!-- Label -->
    <TextView
        android:id="@+id/tvPriorityLabel"
        style="@style/TitleLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Task Priority (Weight)"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/txtPriority"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Current value -->
    <TextView
        android:id="@+id/txtPriority"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1/4"
        android:textColor="@color/brand_blue"
        style="@style/ValueText"
        app:layout_constraintBottom_toBottomOf="@id/tvPriorityLabel"
        app:layout_constraintEnd_toStartOf="@id/ivChevron"
        app:layout_constraintTop_toTopOf="@id/tvPriorityLabel" />

    <!-- Right chevron -->
    <ImageView
        android:id="@+id/ivChevron"
        style="@style/ChevronImageView"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
         />

</androidx.constraintlayout.widget.ConstraintLayout>
