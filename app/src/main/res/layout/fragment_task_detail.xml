<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/task_screen_bg">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutTaskDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/task_screen_bg"
        app:tabTextColor="@color/task_text_secondary"
        app:tabSelectedTextColor="@color/brand_blue"
        app:tabIndicatorColor="@color/brand_blue" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerTaskDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
