<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/completion_dialog_section_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvStepHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/completion_dialog_chip_bg"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/dialog_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="228dp"
            android:layout_height="228dp"
            android:layout_marginBottom="6dp">

            <View
                android:layout_width="162dp"
                android:layout_height="162dp"
                android:layout_gravity="center"
                android:background="@drawable/completion_dialog_center_bg" />

            <com.anitech.growdaily.view.CircularSeekBarView
                android:id="@+id/circularSeekBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="46dp">

                <TextView
                    android:id="@+id/tvDateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/completion_dialog_chip_bg"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="Today"
                    android:textColor="@color/dialog_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/countContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvCountValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/completion_dialog_value_pending"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="16sp"
                        app:autoSizeMaxTextSize="26sp"
                        app:autoSizeStepGranularity="1sp" />

                    <TextView
                        android:id="@+id/tvCountTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/dialog_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/timerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvTimerValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/completion_dialog_value_pending"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeMaxTextSize="18sp"
                        app:autoSizeStepGranularity="1sp" />

                    <TextView
                        android:id="@+id/tvTimerTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/dialog_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Play or Pause"
                    android:src="@drawable/ic_play"
                    app:tint="@color/brand_blue"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStepDown"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/completion_dialog_button_secondary"
                android:elevation="0dp"
                android:paddingHorizontal="8dp"
                android:text="-"
                android:textAllCaps="false"
                android:textColor="@color/completion_dialog_button_secondary_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStepUp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/brand_blue"
                android:elevation="0dp"
                android:paddingHorizontal="8dp"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
