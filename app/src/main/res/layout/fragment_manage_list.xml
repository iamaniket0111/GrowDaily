<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/task_screen_bg"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerCard"
        style="@style/GrowDailyHeaderCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <View
                android:id="@+id/iconBg"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/task_filter_chip"
                android:backgroundTint="@color/task_filter_selected_bg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivTitleIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/none"
                android:src="@drawable/ic_list"
                app:layout_constraintBottom_toBottomOf="@id/iconBg"
                app:layout_constraintEnd_toEndOf="@id/iconBg"
                app:layout_constraintStart_toStartOf="@id/iconBg"
                app:layout_constraintTop_toTopOf="@id/iconBg"
                app:tint="@color/brand_blue" />

            <TextView
                android:id="@+id/txtTitle"
                style="@style/ManageListTitle"
                android:layout_marginStart="12dp"
                android:text="Lists"
                app:layout_constraintBottom_toBottomOf="@id/iconBg"
                app:layout_constraintStart_toEndOf="@id/iconBg"
                app:layout_constraintTop_toTopOf="@id/iconBg" />

            <TextView
                android:id="@+id/txtCount"
                style="@style/ManageListCountChip"
                android:text="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtDescription"
                style="@style/SectionHeaderSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Keep your lists organized here. Drag to reorder, or tap a list to edit its name and tasks."
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconBg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddList"
                style="@style/ManageListAddButton"
                android:backgroundTint="@color/brand_blue"
                android:text="Create new list"
                app:icon="@drawable/ic_add"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtDescription" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/emptyStateContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/buttonSave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerCard">

        <ImageView style="@style/ManageListEmptyIllustration" />

        <TextView
            android:id="@+id/txtEmptyState"
            style="@style/ManageListEmptySubtitle"
            android:text="No lists yet.\nCreate your first list here, then come back to reorder everything." />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/RvCondition"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/buttonSave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerCard" />

    <Button
        android:id="@+id/buttonSave"
        style="@style/PrimaryActionButton"
        android:text="Done"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
