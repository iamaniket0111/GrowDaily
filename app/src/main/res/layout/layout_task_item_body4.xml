<?xml version="1.0" encoding="utf-8"?>
<!-- Version 4: Clean Grid Dashboard Widget Vibe -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/TaskItemBodyCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- Top Block: Icon + Text + Check -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left Profile Icon -->
        <FrameLayout
            style="@style/TaskItemIconFrame"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/imageProfile"
                style="@style/TaskItemIcon" />
        </FrameLayout>

        <!-- Center Text Title & Note -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/taskTitle"
                style="@style/TaskItemTitleText"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="16sp"
                tools:text="Start the Day" />

            <TextView
                android:id="@+id/taskNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/task_text_secondary"
                tools:text="Be ready for the day" />

            <!-- Pending Text -->
            <TextView
                android:id="@+id/taskPendingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/brand_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Pending from Mar 28" />

        </LinearLayout>

        <!-- Right Check Circle -->
        <FrameLayout
            android:id="@+id/doneContainer"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/doneView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:indeterminate="false"
                app:indicatorColor="@color/brand_blue"
                app:indicatorSize="24dp"
                app:trackColor="@color/task_done_track"
                app:trackThickness="2dp" />

            <ImageView
                android:id="@+id/notAllowedImg"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_alarm_clock" />

            <ImageView
                android:id="@+id/done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/circle_background"
                android:src="@drawable/ic_check"
                app:tint="@color/white"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <!-- Divider Line separating content and metadata -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@color/task_done_track"
        android:alpha="0.5" />

    <!-- Bottom Block: Category Tag + Horizontal Badges Flow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/taskType"
            style="@style/TaskItemMetaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Daily" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Badges Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Status Badge (Paused / Stopped) -->
            <LinearLayout
                android:id="@+id/statusContainer"
                style="@style/TaskItemBadgeContainer"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/statusText"
                    style="@style/TaskItemBadgeText"
                    android:textColor="@color/default_text_color"
                    android:textSize="10sp"
                    tools:text="Paused" />

                <ImageView
                    android:id="@+id/statusIcon"
                    style="@style/TaskItemBadgeIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_pause"
                    app:tint="@color/white" />
            </LinearLayout>

            <!-- Schedule Time Badge -->
            <LinearLayout
                android:id="@+id/scheduleTimeContainer"
                style="@style/TaskItemBadgeContainer"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/scheduleTimeText"
                    style="@style/TaskItemBadgeText"
                    android:textColor="@color/default_text_color"
                    android:textSize="10sp"
                    tools:text="08:00 AM" />

                <ImageView
                    android:id="@+id/scheduleClockIcon"
                    style="@style/TaskItemBadgeIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_alarm_clock"
                    app:tint="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/weightContainer"
                style="@style/TaskItemBadgeContainer"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/taskWeight"
                    style="@style/TaskItemBadgeText"
                    android:textColor="@color/default_text_color"
                    android:textSize="10sp"
                    tools:text="1/4" />

                <ImageView
                    android:id="@+id/flag"
                    style="@style/TaskItemBadgeIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_flag_fill"
                    app:tint="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reminderContainer"
                style="@style/TaskItemBadgeContainer"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/remTime"
                    style="@style/TaskItemBadgeText"
                    android:textColor="@color/default_text_color"
                    android:textSize="10sp"
                    tools:text="10:16 PM" />

                <ImageView
                    android:id="@+id/bell"
                    style="@style/TaskItemBadgeIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/streakContainer"
                style="@style/TaskItemBadgeContainer"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/taskStreak"
                    style="@style/TaskItemBadgeText"
                    android:textSize="10sp"
                    tools:text="0" />

                <ImageView
                    android:id="@+id/fire"
                    style="@style/TaskItemBadgeIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_fire_fill"
                    app:tint="@color/iconTint" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
