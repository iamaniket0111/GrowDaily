<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/GrowDailyDialogContainer"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingTop="22dp"
    android:paddingBottom="18dp">

    <ImageView
        android:id="@+id/ivActionIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:layout_marginBottom="18dp"
        android:background="@drawable/circle_background"
        android:backgroundTint="@color/category_dark_blue_25"
        android:contentDescription="Warning"
        android:padding="14dp"
        android:src="@drawable/ic_warning"
        app:tint="@color/category_dark_blue" />

    <TextView
        android:id="@+id/tvActionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="Are you sure?"
        android:textColor="@color/dialog_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvActionMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp"
        android:gravity="center"
        android:text="This action cannot be undone.\n All data associated with this task will be lost."
        android:textAlignment="center"
        android:textColor="@color/dialog_text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="2dp" />

    <Button
        android:id="@+id/primaryButton"
        style="@style/DialogPrimaryButton"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/category_dark_blue"
        android:text="Delete" />

    <Button
        android:id="@+id/secondaryButton"
        style="@style/DialogSecondaryButton"
        android:text="Cancel" />

</LinearLayout>
