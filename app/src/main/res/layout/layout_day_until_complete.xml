<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/untilCompleteRow"
    style="@style/AddFormRow"
    android:layout_height="wrap_content"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show until completed"
            style="@style/TitleLabel" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="If missed, keep showing this day task on later days until it is completed."
            android:textColor="@color/add_form_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchUntilComplete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
