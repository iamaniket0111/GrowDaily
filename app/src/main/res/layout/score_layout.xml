<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="10dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/task_card_stroke"
    app:cardBackgroundColor="@color/task_card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="20dp"
        android:weightSum="3">

        <!-- Today Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/cpi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:indicatorSize="52dp"
                    app:trackThickness="4.5dp"
                    app:trackCornerRadius="10dp"
                    tools:progress="65"
                    app:indicatorColor="@color/category_dark_blue"
                    app:trackColor="@color/task_done_track" />

                <TextView
                    android:id="@+id/doneWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/task_text_primary"
                    android:textSize="15sp"
                    tools:text="6.5" />
            </FrameLayout>

            <TextView
                android:id="@+id/dayText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/task_text_secondary"
                android:textSize="11sp"
                tools:text="Feb 3" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="@color/task_card_stroke"
            android:alpha="0.5" />

        <!-- Week Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/cpiWeek"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:indicatorSize="52dp"
                    app:trackThickness="4.5dp"
                    app:trackCornerRadius="10dp"
                    tools:progress="45"
                    app:indicatorColor="@color/category_purple"
                    app:trackColor="@color/task_done_track" />

                <TextView
                    android:id="@+id/doneWeekWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/task_text_primary"
                    android:textSize="15sp"
                    tools:text="4.2" />
            </FrameLayout>

            <TextView
                android:id="@+id/weekText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:textColor="@color/task_text_secondary"
                android:textSize="11sp"
                tools:text="29 Jan–4 Feb" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="@color/task_card_stroke"
            android:alpha="0.5" />

        <!-- Month Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/cpiMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:indicatorSize="52dp"
                    app:trackThickness="4.5dp"
                    app:trackCornerRadius="10dp"
                    tools:progress="80"
                    app:indicatorColor="@color/category_teal"
                    app:trackColor="@color/task_done_track" />

                <TextView
                    android:id="@+id/doneMonthWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/task_text_primary"
                    android:textSize="15sp"
                    tools:text="18.5" />
            </FrameLayout>

            <TextView
                android:id="@+id/monthText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/task_text_secondary"
                android:textSize="11sp"
                tools:text="January" />
        </LinearLayout>


    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
