<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AddFormCard"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- ── Row 1: 4 type selector buttons ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/typeSelectorContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <TextView
            android:id="@+id/binaryType"
            style="@style/TrackingTypeSelectorButton"
            android:layout_marginEnd="4dp"
            android:text="@string/tracking_binary"
            android:contentDescription="@string/select_tracking_binary" />

        <TextView
            android:id="@+id/countType"
            style="@style/TrackingTypeSelectorButton"
            android:layout_marginHorizontal="4dp"
            android:text="@string/tracking_count"
            android:contentDescription="@string/select_tracking_count" />

        <TextView
            android:id="@+id/timerType"
            style="@style/TrackingTypeSelectorButton"
            android:layout_marginHorizontal="4dp"
            android:text="@string/tracking_timer"
            android:contentDescription="@string/select_tracking_timer" />

        <TextView
            android:id="@+id/checklistType"
            style="@style/TrackingTypeSelectorButton"
            android:layout_marginStart="4dp"
            android:text="@string/tracking_checklist"
            android:contentDescription="@string/select_tracking_checklist" />

    </LinearLayout>

    <!-- ── Row 2: COUNT extra — inline target count with underline ────── -->
    <LinearLayout
        android:id="@+id/countExtraContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/add_form_surface_card"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Target Goal"
            android:textColor="@color/add_form_text_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <EditText
                android:id="@+id/txtCountValue"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/add_form_text_secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:inputType="number"
                android:maxLength="3"
                android:selectAllOnFocus="true"
                android:imeOptions="actionDone"
                android:contentDescription="@string/daily_target_count_label" />

            <View
                android:id="@+id/countUnderline"
                android:layout_width="44dp"
                android:layout_height="2dp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="times"
            android:textColor="@color/add_form_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>


    <!-- ── Row 3: TIMER extra — tappable summary row ────────────────── -->
    <LinearLayout
        android:id="@+id/timerExtraContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/add_form_surface_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/target_duration_label"
            android:textColor="@color/add_form_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtTimerValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:10"
            android:textColor="@color/add_form_text_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_arrow_drop_down"
            android:tint="@color/add_form_text_secondary" />

    </LinearLayout>

    <!-- ── Row 4: CHECKLIST extra — tappable summary row ──────────────── -->
    <LinearLayout
        android:id="@+id/checklistExtraContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/add_form_surface_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Checklist Items"
            android:textColor="@color/add_form_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtChecklistCountValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 items"
            android:textColor="@color/add_form_text_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_arrow_drop_down"
            android:tint="@color/add_form_text_secondary" />

    </LinearLayout>

</LinearLayout>
