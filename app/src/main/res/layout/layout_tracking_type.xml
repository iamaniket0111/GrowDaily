<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AddFormCard"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- ── Row 1: 4 type selector buttons ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/typeSelectorContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <TextView
            android:id="@+id/binaryType"
            style="@style/TrackingTypeSelectorButton"
            android:layout_marginEnd="4dp"
            android:text="@string/tracking_binary"
            android:contentDescription="@string/select_tracking_binary" />

        <TextView
            android:id="@+id/countType"
            style="@style/TrackingTypeSelectorButton"
            android:layout_marginHorizontal="4dp"
            android:text="@string/tracking_count"
            android:contentDescription="@string/select_tracking_count" />

        <TextView
            android:id="@+id/timerType"
            style="@style/TrackingTypeSelectorButton"
            android:layout_marginHorizontal="4dp"
            android:text="@string/tracking_timer"
            android:contentDescription="@string/select_tracking_timer" />

        <TextView
            android:id="@+id/checklistType"
            style="@style/TrackingTypeSelectorButton"
            android:layout_marginStart="4dp"
            android:text="@string/tracking_checklist"
            android:contentDescription="@string/select_tracking_checklist" />

    </LinearLayout>

    <!-- ── Row 2: COUNT extra — target count input ─────────────────────── -->
    <LinearLayout
        android:id="@+id/countExtraContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/daily_target_count_label"
            android:textColor="@color/add_form_text_primary"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnCountMinus"
            style="@style/AddFormCircularIconButton"
            android:contentDescription="@string/decrease_count"
            android:src="@drawable/ic_minus" />

        <TextView
            android:id="@+id/txtCountValue"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/add_form_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCountPlus"
            style="@style/AddFormCircularIconButton"
            android:contentDescription="@string/increase_count"
            android:src="@drawable/ic_add" />

    </LinearLayout>

    <!-- ── Row 3: TIMER extra — target duration picker ─────────────────── -->
    <LinearLayout
        android:id="@+id/timerExtraContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/target_duration_label"
            android:textColor="@color/add_form_text_primary"
            android:textSize="14sp" />

        <!-- Minutes -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMinutesMinus"
                style="@style/AddFormCircularIconButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/decrease_duration"
                android:src="@drawable/ic_minus" />

            <TextView
                android:id="@+id/txtMinutesValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="10"
                android:textColor="@color/add_form_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMinutesPlus"
                style="@style/AddFormCircularIconButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/increase_duration"
                android:src="@drawable/ic_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/minutes_short"
                android:textColor="@color/add_form_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Row 4: CHECKLIST extra — add items ──────────────────────────── -->
    <LinearLayout
        android:id="@+id/checklistExtraContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Existing items list (populated via RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/checklistRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Add item row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etChecklistItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Add checklist item"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLength="150"
                android:maxLines="3"
                android:textColor="@color/add_form_text_primary"
                android:textColorHint="@color/add_form_hint"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnAddChecklistItem"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circular_corners"
                android:backgroundTint="@color/brand_blue"
                android:contentDescription="Add item"
                android:src="@drawable/ic_add"
                app:tint="@color/white" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
