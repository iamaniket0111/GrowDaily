<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude the database from cloud backups to keep user data private -->
        <exclude domain="database" path="task_database" />
        <!-- Optionally exclude preferences if they contain sensitive data -->
        <exclude domain="sharedpref" path="theme_preferences" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow the database to be transferred during a direct device-to-device migration -->
        <include domain="database" path="task_database" />
        <include domain="sharedpref" path="theme_preferences" />
    </device-transfer>
</data-extraction-rules>