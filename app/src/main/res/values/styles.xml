<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="GrowDailyCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/task_fragment_card</item>
    </style>

    <style name="AnalysisCardInclude">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="AddCardInclude">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="WeekdayCheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:buttonTint">@color/brand_blue</item>
        <item name="android:textColor">@color/task_text_primary</item>
    </style>

    <style name="GrowDailyHeaderCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/task_card_surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/task_card_stroke</item>
        <item name="strokeWidth">1.2dp</item>
    </style>

    <style name="GrowDailyDialogContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/dialog_surface_card</item>
    </style>

    <style name="DialogPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DialogSecondaryButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/dialog_secondary_action</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PriorityRadioButton" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/task_fragment_card</item>
        <item name="android:button">@null</item>
        <item name="android:drawableStart">@drawable/radio_selector</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:textColor">@color/task_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CategoryColorCircle" >
        <item name="android:layout_width">27dp</item>
        <item name="android:layout_height">27dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/circle_background</item>
        <item name="android:contentDescription">@string/none</item>
        <item name="android:tint">@color/white</item>
    </style>

    <style name="CategoryStrokeCircle">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/stroke_circular_dark</item>
    </style>

    <style name="TaskBottomSheetDialogTheme"
        parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="bottomSheetStyle">@style/TaskBottomSheetStyle</item>
    </style>


    <style name="TaskBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/circular_corners_more</item>
    </style>

    <style name="WeekLabelText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">9dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">#8A8A8A</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_marginBottom">1dp</item>
    </style>

    <style name="CalendarHeaderDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/task_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TaskItemIconFrame">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
    </style>

    <style name="TaskItemIcon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/circle_background</item>
        <item name="android:contentDescription">@string/none</item>
        <item name="android:padding">6dp</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:src">@drawable/ic_bell</item>
        <item name="android:tint">@color/white</item>
    </style>

    <style name="TaskItemMetaText">
        <item name="android:textColor">@color/brand_blue</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TaskItemTitleText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/task_text_primary</item>
    </style>

    <style name="TaskItemBadgeContainer">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/circular_corners_less</item>
        <item name="android:backgroundTint">@color/task_done_track</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="TaskItemBadgeText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/task_text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TaskItemBadgeIcon">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">14dp</item>
    </style>

    <style name="TaskItemBodyCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/task_fragment_card</item>
        <item name="android:baselineAligned">false</item>
    </style>

    <style name="ReorderFilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:background">@drawable/task_filter_chip</item>
        <item name="android:backgroundTint">@color/task_chip_surface</item>
        <item name="android:textColor">@color/task_text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ReorderDoneButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_margin">24dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">28dp</item>
    </style>





    <style name="Theme.GrowDaily.Picker.Base" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
