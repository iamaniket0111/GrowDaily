    <style name="TitleLabel">
        <item name="android:textColor">@color/add_form_text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
-->
    <style name="TitleLabel">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/add_form_text_primary</item>
    </style>


    <style name="ValueText">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="ChevronImageView">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:src">@drawable/ic_right_arrow</item>
        <item name="tint">@color/add_form_icon</item>
    </style>

    <!-- styles.xml -->
    <style name="AnalysisTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">normal</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">@color/task_text_primary</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="SectionHeaderSubtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/task_text_secondary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
</resources>
